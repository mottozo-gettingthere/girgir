{
  "id": "./",
  "name": "Girgir 5G",
  "short_name": "Girgir 5G",
  "description": "Phone-to-phone intercom over mobile data. Invites go by WhatsApp, AirDrop or Bluetooth; Girgir (Wi-Fi) takes over when data drops.",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0e10",
  "theme_color": "#0a0e10",
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "related_applications": [
    { "platform": "webapp", "url": "https://mottozo-gettingthere.github.io/girgir/manifest.webmanifest" }
  ],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
